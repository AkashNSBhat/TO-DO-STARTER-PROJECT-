{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAYMARK",
  "version": "0.1.0",
  "identifier": "com.daymark.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DAYMARK — Every day counts. Every completion stays.",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Every day counts. Every completion stays.",
    "longDescription": "DAYMARK is a 100% offline-first Windows desktop productivity and entertainment ledger application.",
    "copyright": "Copyright © 2025 DAYMARK. All rights reserved.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
